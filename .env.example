# Settings for docker-compose.prod.yml. Copy to .env next to it and fill in the blanks.
# On the servers, the deploy workflow writes .env from GitHub Secrets; never commit a real one.
# Values are read verbatim (no quotes needed, even with spaces).

# --- Deployment (local-check values shown; prod values in comments) ---
# Image to run. Prod: ghcr.io/ghechtrdi/amr_grand_prix:<git sha>
APP_IMAGE=amr-grand-prix:local
# Prod: grandprix.alaskamountainrunners.org  Sandbox: sandbox.grandprix.alaskamountainrunners.org
SITE_ADDRESS=http://localhost
# Prod/sandbox: tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
CADDY_TLS=
# Prod: /mnt/pgdata/data (a subdirectory: the mount root holds lost+found, which initdb rejects). Empty = Docker named volume.
POSTGRES_DATA=

# --- Database ---
POSTGRES_DB=amr_grand_prix
POSTGRES_USER=amrgp
# Generate with: openssl rand -hex 32  (hex keeps it safe inside the connection string)
POSTGRES_PASSWORD=

# --- App secrets ---
# Generate with: openssl rand -base64 48
Jwt__Secret=
Llm__Anthropic__ApiKey=
# Cloudflare Turnstile secret key (pairs with VITE_TURNSTILE_SITE_KEY in AmrGrandPrix.Client/.env)
Captcha__SecretKey=

# --- Email (Resend SMTP; port 587 STARTTLS is required, 465 won't work) ---
Email__SmtpHost=smtp.resend.com
Email__SmtpPort=587
Email__EnableSsl=true
Email__SmtpUsername=resend
# Resend API key for this environment
Email__SmtpPassword=
# Prod: akmtnrunners@gmail.com  Sandbox: a developer address
Email__ClubNotificationEmail=
