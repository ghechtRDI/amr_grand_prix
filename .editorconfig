root = true

[*.cs]
# CA1848: LoggerMessage delegates only pay off on hot logging paths; this app's log
# volume is low, and plain ILogger calls are easier to read and maintain.
dotnet_diagnostic.CA1848.severity = none

# EF Core migrations are generated code; don't hand-edit them to satisfy analyzers.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
